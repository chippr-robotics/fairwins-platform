{
  "name": "prediction-dao-research",
  "version": "1.18.0",
  "description": "Futarchy Prediction DAO with privacy-preserving mechanisms",
  "private": true,
  "workspaces": [
    "frontend",
    "frontend/miniapps/*",
    "services/relay-gateway",
    "services/finops-exporter",
    "subgraph",
    "tools/miniapp-build",
    "packages/*"
  ],
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "postcompile": "node scripts/codegen/write-build-marker.js",
    "test": "hardhat test",
    "test:unit": "hardhat test test/*.test.js",
    "test:integration": "hardhat test test/integration/**/*.test.js",
    "test:integration:clearpath": "hardhat test test/integration/clearpath/**/*.test.js",
    "test:integration:oracle": "hardhat test test/integration/oracle/*.test.js",
    "test:integration:fairwins": "hardhat test test/integration/fairwins/**/*.test.js",
    "test:oracles": "hardhat test test/oracles/*.test.js",
    "test:fork": "hardhat test test/fork/*.test.js",
    "test:all": "hardhat test test/**/*.test.js",
    "test:gas": "REPORT_GAS=true hardhat test",
    "test:coverage": "COVERAGE=true TZ=UTC hardhat coverage --testfiles '{test/*.test.js,test/access/**/*.test.js,test/account/**/*.test.js,test/bridge/**/*.test.js,test/clearpath/**/*.test.js,test/custody/**/*.test.js,test/intent/**/*.test.js,test/liquidity/**/*.test.js,test/oracles/**/*.test.js,test/pools/**/*.test.js,test/staking/**/*.test.js,test/tokens/**/*.test.js,test/upgradeable/**/*.test.js,test/integration/**/*.test.js}'",
    "deploy:local": "hardhat run scripts/deploy/deploy.js --network localhost",
    "deploy:mordor": "hardhat run scripts/deploy/deploy.js --network mordor",
    "deploy:polygon": "hardhat run scripts/deploy/deploy.js --network polygon",
    "deploy:etc": "hardhat run scripts/deploy/deploy.js --network etc",
    "verify:mordor": "hardhat run scripts/deploy/verify.js --network mordor",
    "verify:etc": "hardhat run scripts/deploy/verify.js --network etc",
    "verify:amoy": "hardhat run scripts/deploy/verify.js --network amoy",
    "verify:polygon": "hardhat run scripts/deploy/verify.js --network polygon",
    "verify:passkey-support": "node scripts/ops/verify-passkey-support.js",
    "check:storage-layout": "hardhat run scripts/deploy/check-storage-layout.js",
    "tenants:validate": "node scripts/tenants/validate-tenant-manifest.js",
    "test:tenants": "node --test \"scripts/tenants/__tests__/*.test.js\"",
    "check:native-versions": "node scripts/native/check-native-versions.js",
    "sync:frontend-contracts": "node scripts/utils/sync-frontend-contracts.js --network mordor --chainId 63",
    "sync:frontend-contracts:amoy": "node scripts/utils/sync-frontend-contracts.js --network amoy --chainId 80002",
    "sync:frontend-contracts:polygon": "node scripts/utils/sync-frontend-contracts.js --network polygon --chainId 137",
    "migrate:memberships:polygon": "hardhat run scripts/operations/migrate-memberships-007.js --network polygon",
    "lockdown:polygon": "hardhat run scripts/operations/prelaunch-lockdown-007.js --network polygon",
    "sync:frontend-contracts:local": "node scripts/utils/sync-frontend-contracts.js --network localhost --chainId 1337",
    "test:frontend": "npm run test:run --workspace frontend",
    "lock:sync": "npm install --package-lock-only",
    "seed:testnet": "hardhat run scripts/operations/seed-testnet.js --network mordor",
    "seed:local": "hardhat run scripts/operations/seed-local.js --network localhost",
    "deploy:local:pools": "hardhat run scripts/deploy/deploy-wager-pool-factory.js --network localhost",
    "deploy:local:funding": "hardhat run scripts/deploy/deploy-funding-pool-factory.js --network localhost",
    "deploy:local:fees": "hardhat run scripts/deploy/deploy-fee-router.js --network localhost",
    "deploy:local:earn-vault": "hardhat run scripts/deploy/deploy-local-earn-vault.js --network localhost",
    "deploy:local:staking": "hardhat run scripts/deploy/deploy-staking-router.js --network localhost",
    "deploy:local:miniapps": "hardhat run scripts/deploy/deploy-miniapp-registry.js --network localhost",
    "deploy:local:backup-pointer": "E2E_AMOY_LOCAL=1 hardhat run scripts/deploy/deploy-backup-pointer-registry.js --network localhost",
    "deploy:local:clearpath": "hardhat run scripts/deploy/deploy-clearpath.js --network localhost",
    "deploy:local:token-v2": "hardhat run scripts/deploy/upgrade-token-factory-v2.js --network localhost",
    "deploy:local:callsigns": "hardhat run scripts/deploy/deploy-callsign-registry.js --network localhost",
    "deploy:local:swap": "hardhat run scripts/deploy/deploy-local-swap.js --network localhost",
    "publish:local:miniapps": "node scripts/miniapps/publish.js --app token-mint --dev && node scripts/miniapps/publish.js --app clearpath --dev && node scripts/miniapps/publish.js --app api-access --dev",
    "_comment:setup-order": "THE ORDER OF THE TARGETED DEPLOYS IS LOAD-BEARING. Each uses plain CREATE, so every address below the insertion point is a function of the deployer's nonce, and both wagerPoolFactory (spec 034) and feeRouter (spec 060) are HARDCODED in frontend/src/config/contracts.js because the E2E tier deliberately does not sync. Inserting or reordering a deploy here silently repoints the app at an address nothing was deployed to. Append new ones at the END, then re-derive and update the constant.",
    "setup:local": "npm run deploy:local && npm run deploy:local:pools && npm run deploy:local:fees && npm run deploy:local:earn-vault && npm run deploy:local:funding && npm run sync:frontend-contracts:local && npm run check:e2e-addresses && npm run seed:local",
    "node:e2e": "HARDHAT_LOCAL_CHAIN_ID=80002 hardhat node",
    "check:e2e-addresses": "node scripts/e2e/check-local-addresses.js",
    "test:e2e-addresses": "node --test \"scripts/e2e/__tests__/*.test.js\"",
    "test:build-marker": "node --test \"scripts/codegen/__tests__/*.test.js\"",
    "setup:e2e": "E2E_AMOY_LOCAL=1 npm run deploy:local && npm run deploy:local:pools && E2E_AMOY_LOCAL=1 npm run deploy:local:fees && E2E_AMOY_LOCAL=1 npm run deploy:local:earn-vault && npm run setup:e2e:custody && npm run deploy:local:bridge-liquidity && npm run deploy:local:staking && npm run deploy:local:miniapps && E2E_AMOY_LOCAL=1 npm run seed:local && npm run deploy:local:clearpath && npm run deploy:local:token-v2 && npm run deploy:local:swap && npm run deploy:local:callsigns && npm run publish:local:miniapps && npm run deploy:local:backup-pointer && npm run deploy:local:funding && npm run check:e2e-addresses -- --chainId 80002 --e2e",
    "deploy:local:bridge-liquidity": "hardhat run scripts/deploy/deploy-bridge-liquidity.js --network localhost",
    "setup:e2e:custody": "hardhat run scripts/e2e/setup-custody-fixtures.js --network localhost",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "frontend": "npm run dev --workspace frontend",
    "floppy:mount": "bash ./scripts/operations/floppy-key/mount.sh",
    "floppy:unmount": "bash ./scripts/operations/floppy-key/unmount.sh",
    "floppy:create": "node ./scripts/operations/floppy-key/index.js create",
    "floppy:test": "node ./scripts/operations/floppy-key/index.js test",
    "floppy:info": "node ./scripts/operations/floppy-key/index.js info",
    "floppy:store-admin": "node ./scripts/operations/floppy-key/store-admin-key.js",
    "purchase:friend-market": "npx hardhat run ./scripts/operations/purchase-friend-market-membership.js --network mordor",
    "create:friend-bet": "npx hardhat run ./scripts/operations/create-friend-market-bet.js --network mordor",
    "check:deps": "node scripts/deps/check-dependency-hygiene.js",
    "check:chainlink-closure": "node scripts/security/chainlink-closure.js",
    "dismiss:alerts": "node scripts/security/dismiss-alerts.js",
    "check:iac": "node scripts/infra/check-iac-guardrails.js",
    "check:finops": "node scripts/finops/check-finops-coverage.js",
    "e2e:matrix": "node scripts/e2e/generate-coverage-matrix.js",
    "check:e2e-matrix": "node scripts/e2e/generate-coverage-matrix.js --check",
    "check:e2e-trackers": "node scripts/e2e/check-absent-trackers.js",
    "check:specs": "node scripts/specs/check-spec-registry.js",
    "check:ci-gating": "node scripts/ci/check-ci-gating.js",
    "check:build-args": "node scripts/ci/check-build-args.js && node --test scripts/ci/__tests__/check-build-args.test.js",
    "test:ci": "node --test \"scripts/ci/__tests__/*.test.js\"",
    "test:specs": "node --test \"scripts/specs/__tests__/*.test.js\"",
    "e2e:split": "node scripts/e2e/split-full-tier.js",
    "e2e:split:fast": "node scripts/e2e/split-fast-tier.js",
    "finops:generate": "node scripts/finops/generate-dashboards.js",
    "finops:provision": "node scripts/finops/provision-grafana.js",
    "test:finops": "npm test --workspace fairwins-finops-exporter",
    "test:iac-guardrails": "node --test \"scripts/infra/__tests__/*.test.js\"",
    "test:finops-gate": "node --test \"scripts/finops/__tests__/*.test.mjs\"",
    "test:mcp": "node --test \"services/mcp-server/test/*.test.js\"",
    "build:miniapps": "npm run build --workspace @fairwins/miniapp-token-mint && npm run build --workspace @fairwins/miniapp-clearpath && npm run build --workspace @fairwins/miniapp-api-access",
    "deps:reinstall": "bash scripts/deps/reinstall.sh",
    "codegen:abis": "node scripts/codegen/emit-abis.js",
    "check:abis": "node scripts/codegen/emit-abis.js --check",
    "release:version": "node scripts/release/version.js",
    "release:classify": "node scripts/release/classify.js",
    "release:artifacts": "node scripts/release/artifacts.js",
    "test:release": "node --test \"scripts/release/__tests__/*.test.js\"",
    "test:market-templates": "node --test \"scripts/operations/market-templates/__tests__/*.test.js\"",
    "sec": "node scripts/secrets/with-secrets.js",
    "secrets:doctor": "node scripts/secrets/doctor.js",
    "secrets:migrate": "node scripts/secrets/migrate.js",
    "check:env-hygiene": "node scripts/secrets/check-env-hygiene.js",
    "check:dep-alerts": "node scripts/security/check-dependency-alerts.js",
    "check:dep-alerts:live": "node scripts/security/check-dependency-alerts.js --live",
    "test:dep-alerts": "node --test \"scripts/security/__tests__/*.test.js\"",
    "test:secrets": "node --test \"scripts/secrets/__tests__/*.test.js\""
  },
