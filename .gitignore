# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
coverage.json
*.lcov

# spec 046: the coverage GATE source lives under *coverage* dirs — keep it tracked
# (the bare `coverage` rule above would otherwise ignore these first-party sources).
!scripts/coverage/
!scripts/coverage/**
!test/coverage/
!test/coverage/**

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp
.cache

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite logs files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Hardhat files
cache
artifacts
typechain-types

# Gas reporter
gas-report.txt
gasReporterOutput.json

# Security analysis tools
.slither/
slither-report.json
slither-report.md
crytic-export/
mcore_*
manticore-output/
medusa-output/
.medusa/
medusa-corpus/

# MkDocs
site/

# Playwright MCP session artifacts (console logs, page snapshots, downloaded
# browser extensions like the MetaMask .crx) — transient, can be tens of MB.
.playwright-mcp/

# Stray Playwright screenshots saved to repo root
/dashboard-loaded.png
/open-challenge-modal-taker.png

# Blockscout solc standard-json inputs emitted by scripts/deploy/lib/helpers.js (spec 074)
blockscout/
.dependencygraph/

# Turborepo local task cache (spec 075)
.turbo/

# Terraform (spec 085). NOTE the deliberate exceptions below — both files are
# committed on purpose and must NOT be added to the ignore list:
#   .terraform.lock.hcl          provider pinning; guardrail G-13 requires it committed
#   bootstrap/terraform.tfstate  the trust root's audit record (contracts/state-backend.md)
.terraform/
*.tfplan
crash.log
crash.*.log
# Environment state never lives on disk — it is in GCS. Bootstrap state is the one
# exception and is re-included below.
*.tfstate
*.tfstate.*
!infra/terraform/bootstrap/terraform.tfstate
# tfvars may carry environment-specific values; the committed ones are explicit.
*.auto.tfvars

# Ansible (spec 085)
infra/ansible/*.retry
infra/ansible/collections/

# Local-chain deployment record written by `npm run setup:local` (deploy:local).
# Ephemeral: the addresses change with every fresh hardhat node, so committing one
# publishes a snapshot of somebody's throwaway chain. The full E2E tier regenerates
# it on every run, in CI and locally alike.
deployments/localhost-chain*-v2.json
.build-marker.json

# Signing keystores. NEVER commit one — a Play upload key in git history is a key you must assume
# is compromised, and the only remedy is Play's key-reset process. Generate these OUTSIDE the repo;
# the payload's home is Secret Manager (#1378 H2), never the working tree.
*.jks
*.keystore
*.p12
