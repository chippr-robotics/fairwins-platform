{
  "name": "prediction-dao-research-subgraph",
  "version": "1.18.0",
  "description": "Subgraph for the v2 WagerRegistry — indexes wagers + per-transfer WagerTransfer records (txHash) that power the My Wagers view, site stats, and the RPC-light tax/activity report.",
  "private": true,
  "scripts": {
    "codegen": "graph codegen",
    "build": "graph build",
    "build:amoy": "graph build --network polygon-amoy",
    "build:mordor": "graph build --network mordor",
    "deploy:polygon": "graph deploy fairwins-polygon --studio --network matic",
    "deploy:amoy": "graph deploy fairwins-amoy --studio --network polygon-amoy",
    "create-local": "graph create --node http://localhost:8020/ fairwins",
    "deploy-local": "graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 fairwins",
    "test:matchstick": "graph test"
  },
  "devDependencies": {
    "@fairwins/abi": "*",
    "@graphprotocol/graph-cli": "0.98.1",
    "@graphprotocol/graph-ts": "0.38.2",
    "matchstick-as": "0.6.0"
  }
}
