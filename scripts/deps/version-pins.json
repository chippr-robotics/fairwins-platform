{
  "$comment": [
    "Third-party versions OUTSIDE the npm lockfile (ADR-006, issue #1648).",
    "",
    "npm and GitHub Actions are watched by Dependabot, and so are Terraform providers and the Gradle wrapper",
    "(.github/dependabot.yml). This file covers what Dependabot cannot see or cannot decide: images we",
    "BUILD from an upstream git tag (OZ Relayer, alto), images with a deliberate hold, toolchain lines",
    "chosen in workflows, and the VM/Ansible pins. Container images ARE also watched by Dependabot's",
    "docker / docker-compose ecosystems. They are listed here too, because coverage (V-04) and",
    "exactness (V-05) are enforced by this file's gate, not by Dependabot.",
    "",
    "status: track  = we intend to follow upstream; the weekly report shows how far behind we are.",
    "status: hold   = deliberately behind. It needs hold.reason (why newer is worse FOR US), hold.ref",
    "                 (the evidence), hold.reviewBy (no more than reviewWindowDays out), and hold.watch",
    "                 (the upstream events that would lift it). An expired hold fails every pull request:",
    "                 bump, or renew deliberately with fresh evidence.",
    "",
    "locations[].contains must appear verbatim in that file and must contain `pinned` (V-03), so a bump",
    "that forgets this registry fails in the same pull request.",
    "",
    "exemptions are time-boxed exceptions to V-05 (floating tags). Same rule as holds: a reason, a",
    "ref and an expiry. The list must only ever shrink."
  ],
  "reviewWindowDays": 180,
  "firstPartyPrefixes": [
    "us-central1-docker.pkg.dev/chippr-bots-site-wp/",
    "fairwins-relay-gateway:local"
  ],
  "exemptions": [
    {
      "file": "infra/vm/bundler/docker-compose.yml",
      "contains": "alto-bundler-nginx:latest",
      "reason": "First-party origin-lock image. Cloud Build pushes $SHORT_SHA alongside :latest, but the SHA actually running on the bundler VM is not recorded in the repo. Pinning a guessed SHA would be a fabricated fact; pin the deployed one once it has been read from Artifact Registry.",
      "ref": "#1657",
      "reviewBy": "2026-11-30"
    },
    {
      "file": "services/alto-bundler/deploy/service.yaml",
      "contains": "alto-bundler-nginx:latest",
      "reason": "Same first-party origin-lock image as the VM compose entry, in the retained Cloud Run manifest. Pin it to the same deployed SHA in the same change.",
      "ref": "#1657",
      "reviewBy": "2026-11-30"
    },
    {
      "file": "subgraph/matchstick.Dockerfile",
      "contains": "ubuntu:22.04",
      "reason": "Dev-only matchstick test image. Ubuntu's 22.04 tag moves with point releases and this image also curl-installs EOL Node 18; both are replaced together in the Node line migration rather than pinned in place.",
      "ref": "#1658",
      "reviewBy": "2027-01-30"
    }
  ],
  "pins": [
    {
      "id": "oz-relayer-engine",
      "kind": "git-built-image",
      "owner": "relay",
      "pinned": "v1.4.0",
      "status": "hold",
      "locations": [
        {
          "path": "services/oz-relayer/Dockerfile",
          "contains": "fairwins-relay-engine-base:v1.4.0"
        },
        {
          "path": "services/relay-gateway/docker-compose.yml",
          "contains": "openzeppelin-relayer:v1.4.0"
        }
      ],
      "upstream": {
        "type": "git",
        "repo": "https://github.com/OpenZeppelin/openzeppelin-relayer",
        "tagPattern": "^v\\d+\\.\\d+\\.\\d+$"
      },
      "hold": {
        "reason": "1.5.0 introduced a receipt regression (upstream #817): a transient empty receipt from a load-balanced RPC finalizes a MINED tx as Failed and the confirmed webhook never fires. Our engine uses multi-endpoint public RPC failover, so we would hit it. 1.7.0's nonce-drift recovery jams when the drift region is full (#843). The cap-bound stuck lane (#808) affects 1.4.0 through 1.8.0 alike, so bumping does not fix it; it is mitigated by the probe and the runbook instead. NOTE: the production compose tag is `multichain-v1.5.0`, whose base engine version is not recorded in-repo; verifying it is #1650.",
        "ref": "#1648",
        "watch": [
          "OpenZeppelin/openzeppelin-relayer#817",
          "OpenZeppelin/openzeppelin-relayer#808",
          "OpenZeppelin/openzeppelin-relayer#843",
          "OpenZeppelin/openzeppelin-relayer#757"
        ],
        "reviewBy": "2027-01-09"
      }
    },
