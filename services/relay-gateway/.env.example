# FairWins relay gateway — local/dev environment. NEVER commit a filled-in .env.
# In production these come from Secret Manager / Cloud Run env (see README).

# Chains served (default: the chains with deployments/ records). 61 (ETC mainnet) has no
# deployment record yet — enabling it fails the FR-025 startup check by design.
ENABLED_CHAIN_IDS=137,80002,63

# Tenant scope (spec 072): one gateway process serves ONE tenant. Set to a tenant id to
# read that tenant's dedicated records (deployments/tenants/<id>/) — the FR-025 allowlist
# then IS the tenant boundary, and quotas/killswitch/paymaster are per-process = per-tenant.
# UNSET (or fairwins) => the shared/default estate, exactly as before.
#TENANT_ID=

# >=2 endpoints per chain, comma-separated, failover order (FR-007). Defaults are public pairs
# (publicnode primary, a second independent public provider as secondary — drpc.org for Polygon).
#RPC_URLS_137=https://polygon-bor-rpc.publicnode.com,https://polygon.drpc.org
# A credentialed primary is prepended to the list above, never written into it — its token is
# in the URL path. In production it arrives from Secret Manager (QUICKNODE_POLYGON_API).
#RPC_URL_PRIMARY_137=https://<your-endpoint>/<token>
#RPC_URLS_80002=https://rpc-amoy.polygon.technology,https://polygon-amoy-bor-rpc.publicnode.com
#RPC_URLS_63=https://rpc.mordor.etccooperative.org,https://geth-mordor.etc-network.info
#
# RPC_URL_PRIMARY_<chainId> IS CHAIN-GENERIC, not Polygon-specific — config/index.js reads it inside
# the per-chain loop, so RPC_URL_PRIMARY_80002 / RPC_URL_PRIMARY_63 work exactly the same way for any
# ENABLED_CHAIN_IDS entry (test/rpcEndpoints.test.js asserts this for 80002). Only 137 has a
# provisioned QuickNode credential today (QUICKNODE_POLYGON_API, see
# docs/runbooks/credential-rotation.md); wiring one for another chain is a spec-097
# secrets-registry + fetch-secrets.sh change, not a code change here.

# Origin lock (FR-029): same secret the Cloudflare Transform Rule injects as X-Origin-Auth.
# UNSET => lock disabled (dev only; production MUST set it).
ORIGIN_AUTH_SECRET=
# Operator-only /status disclosure (#1505). Guards `callerIdentity.enforcing` ONLY — the one field
# that tells a caller whether the identity layer is refusing anything. It needs its own secret
# because ORIGIN_AUTH_SECRET is injected by Cloudflare for every request and therefore gates
# nothing. Unset ⇒ the field is absent for everyone (never a fallback to public). The identity mode
# is printed at boot and on every SIGHUP reload regardless, which is where FR-015 is satisfied.
OPS_STATUS_SECRET=

# Engine (OpenZeppelin Relayer) — see ../oz-relayer/README.md
ENGINE_URL=http://localhost:8080
#ENGINE_API_KEY=
# Engine relayer ids default to <name>-<chainId>: polygon-137, amoy-80002, etc-61, mordor-63
#ENGINE_RELAYER_ID_137=polygon-137

# Shared secret the engine presents on POST /v1/engine/webhook (X-Webhook-Secret).
# UNSET => all webhooks rejected (fail closed).
WEBHOOK_SHARED_SECRET=

# Kill switch (FR-015): boot value; toggle at runtime with `kill -USR2 <pid>`.
KILL_SWITCH=false

# Quotas / caps (FR-009/FR-014/FR-018)
#SIGNER_QUOTA_PER_MIN=12
#GLOBAL_QUOTA_PER_MIN=120
# Coarse per-IP route limiters (express-rate-limit) in front of the quotas above. On the VM
# deployment nginx fronts the container and `trust proxy` is unset, so these act as AGGREGATE
# ceilings there — size accordingly. 0 disables a limiter.
#RATE_LIMIT_HEALTH_PER_MIN=600
#RATE_LIMIT_INTENTS_PER_MIN=300
#MAX_QUEUE_DEPTH=100
#GAS_SPEND_CAP_WEI_137=500000000000000000
#SPEND_WINDOW_MS=3600000

# healthz runway (observability only — the KEY never lives here)
#GAS_WALLET_137=0x...
#PEAK_BURN_WEI_PER_HR_137=50000000000000000

#PORT=8788

# --- Sponsored paymaster (spec 050) -----------------------------------------------------------
# Sponsorship is enabled ONLY on chains with a paymaster address set below, so leaving just
# PAYMASTER_ADDRESS_137 set scopes sponsorship to Polygon mainnet. Unset => /v1/paymaster refuses
# that chain and the SPA self-funds (never-stranded).
#PAYMASTER_ADDRESS_137=0x...              # deployed FairWinsVerifyingPaymaster (from deployments/polygon.json)
#ENTRYPOINT_V06_137=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789   # default; override only if needed
# Sponsorship signer: dev/CI uses a raw key (NEVER a production secret); prod uses Cloud KMS.
#PM_SIGNER_PRIVATE_KEY=0x...              # dev/test only
#PM_SIGNER_KMS_KEY=projects/.../cryptoKeyVersions/1   # prod (same custody class as the relayer gas key)
# Per-op ceilings + burst quotas (defense-in-depth; the deposit is the hard cap).
#PM_MAX_COST_WEI=2000000000000000000      # 2 MATIC / op worst-case cost ceiling
#PM_MAX_GAS=3000000                       # per-op gas-units ceiling (deploy+transfer < ~2M)
#PM_ACCOUNT_QUOTA_PER_MIN=6
#PM_GLOBAL_QUOTA_PER_MIN=60
#PM_APPROVAL_TTL_SEC=180                  # sponsorship approval validity window
#PM_RUNWAY_WARN_HRS=48                    # deposit runway warning threshold (observability)

# --- OpenSea proxy (spec 055 read + spec 056 sell-side) -----------------------------------------
# UNSET key => /v1/opensea/* fails closed (503 collectibles_unconfigured) and the SPA hides the
# Collect tab; nothing else is affected. In prod the key comes from Secret Manager.
#OPENSEA_API_KEY=
#OPENSEA_BASE_URL=https://api.opensea.io
#OPENSEA_TIMEOUT_MS=5000
#OPENSEA_RETRIES=1
#OPENSEA_CACHE_TTL_MS=60000               # account list / item detail / fee cache
#OPENSEA_STATS_CACHE_TTL_MS=300000        # collection floor stats cache (floors move slowly)
#OPENSEA_QUOTA_PER_ADDRESS=60             # reads/min per requested address|contract|slug
#OPENSEA_QUOTA_GLOBAL=300                 # reads/min backstop for the shared key
# Sell-side writes (spec 056): a separate, tighter quota keyed by the seller's account address.
#OPENSEA_WRITE_QUOTA_PER_ADDRESS=20       # listings/cancels/accepts per minute per seller
#OPENSEA_WRITE_QUOTA_GLOBAL=100           # writes/min backstop for the shared key
# FairWins referral/affiliate beneficiary of OpenSea's OWN reward (public address; never a surcharge).
# UNSET => attribution disabled (safe default). Per-chain override wins over the global.
#OPENSEA_REFERRAL_ADDRESS=0x...
#OPENSEA_REFERRAL_ADDRESS_137=0x...

# --- Polymarket / Predict proxy (spec 057) -----------------------------------------------------
# UNSET key => /v1/polymarket/* fails closed (503 predict_unconfigured) and the SPA hides the
# Predict tab; nothing else is affected. Polygon-only (Polymarket runs only on 137). In prod the
# key + L2 secret/passphrase come from Secret Manager (the L2 creds are derived once offline via
# L1, so the gateway holds no order-signing key).
#POLYMARKET_API_KEY=
#POLYMARKET_API_SECRET=                    # base64url L2 HMAC secret (from POST /auth/api-key)
#POLYMARKET_API_PASSPHRASE=
#POLYMARKET_API_ADDRESS=0x...              # the operator wallet the API creds belong to
#POLYMARKET_BASE_URL=https://clob.polymarket.com
# Polymarket splits across three public hosts: CLOB (orders/fees/auth), Gamma (market discovery +
# search), Data API (positions). Browse hits Gamma, positions hit Data — both public (no L2 creds).
#POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
#POLYMARKET_DATA_URL=https://data-api.polymarket.com
#POLYMARKET_TIMEOUT_MS=5000
#POLYMARKET_RETRIES=1
#POLYMARKET_CACHE_TTL_MS=15000             # market/fee read cache (prices move fast)
#POLYMARKET_QUOTA_PER_ADDRESS=60           # reads/min per requested address
#POLYMARKET_QUOTA_GLOBAL=300               # reads/min backstop for the shared key
#POLYMARKET_WRITE_QUOTA_PER_ADDRESS=20     # order/cancel per minute per trader
#POLYMARKET_WRITE_QUOTA_GLOBAL=100         # writes/min backstop for the shared key
# FairWins builder code (public bytes32). UNSET => orders post UNATTRIBUTED (never stranded), no fee.
# The builder fee is ADDITIVE on top of Polymarket's platform taker fee (a real user cost, disclosed
# honestly in the UI). Hard-capped at 100 bps taker / 50 bps maker — out-of-range fails boot.
#POLYMARKET_BUILDER_CODE=0x6e0316783960e149b53466f0f2c5fdbaf5ce11ba15669491de980f6dedc493a3
#POLYMARKET_BUILDER_TAKER_FEE_BPS=50       # 0.50% on taker orders (default; FALLBACK since spec 060 — the FeeRouter is the live source)
#POLYMARKET_BUILDER_MAKER_FEE_BPS=0        # makers kept whole (default; fallback since spec 060)

# --- Bitcoin proxy (spec 061) ------------------------------------------------------------------
# DISABLED by default => /v1/bitcoin/* fails closed (503 bitcoin_disabled) and the SPA soft-fails
# the Bitcoin capability; nothing else is affected. When enabled, malformed URLs or a nonsensical
# fee clamp fail the boot loudly. The gateway holds NO Bitcoin keys — pure data reads plus a
# raw-tx broadcast relay of client-signed transactions.
#BTC_ENABLED=false
#BTC_ESPLORA_URL=https://mempool.space/api                    # Esplora-compatible mainnet upstream
#BTC_ESPLORA_TESTNET_URL=https://mempool.space/testnet4/api   # Esplora-compatible testnet4 upstream
# Stamps indexer (stampchain.io-compatible). UNSET => stamps route answers degraded:true and the
# client fail-safes by treating unverified coins as protected (never spends a possible Stamp).
#BTC_STAMPS_URL=https://stampchain.io
#BTC_MAX_FEE_RATE=500                      # sat/vB clamp on fee responses (>= 1 when enabled)
#BTC_TIMEOUT_MS=5000
#BTC_RETRIES=1                             # read retries on 5xx/transport (broadcast never retries)
#BTC_QUOTA_PER_IP=60                       # reads/min per caller IP (polymarket parity)
#BTC_QUOTA_GLOBAL=300                      # reads/min backstop across all callers
#BTC_WRITE_QUOTA_PER_IP=20                 # broadcasts/min per caller IP (stricter than reads)
#BTC_WRITE_QUOTA_GLOBAL=100                # broadcasts/min backstop
#BTC_KILLSWITCH=false                      # ops kill: all /v1/bitcoin/* routes 503 bitcoin_killed

# FeeRouter (spec 060): on-chain source of truth for the Polymarket builder bps. Defaults to the
# deployment record's feeRouter for FEE_ROUTER_CHAIN_ID; an override contradicting the record
# fails boot. Unset + not in the record => env-fallback mode (the two bps values above).
#FEE_ROUTER_ADDRESS=
#FEE_ROUTER_CHAIN_ID=137
#FEE_ROUTER_CACHE_TTL_MS=30000             # bounds how long an admin rate change takes to go live

# ---- Perps read proxy (spec 082) -------------------------------------------------------------
# Read-only market data + member positions from Gains Network / GMX / Hyperliquid, plus the
# public attribution config. No secrets exist in this module; all venue APIs are public.
# Disabled (default) => /v1/perps/* answers 503 perps_unconfigured and the SPA hides the view.
#PERPS_ENABLED=true
#PERPS_GAINS_URL_ARBITRUM=https://backend-arbitrum.gains.trade   # empty string disables one chain
#PERPS_GAINS_URL_BASE=https://backend-base.gains.trade
#PERPS_GAINS_URL_POLYGON=https://backend-polygon.gains.trade
#PERPS_GAINS_PRICING_URL=https://backend-pricing.eu.gains.trade  # global pair-price snapshot
#PERPS_GMX_URL=https://arbitrum-api.gmxinfra.io
#PERPS_GMX_CHAIN_ID=42161
#PERPS_HL_URL=https://api.hyperliquid.xyz
#PERPS_TIMEOUT_MS=8000
#PERPS_RETRIES=1
#PERPS_CACHE_TTL_MS=15000                  # pairs/positions read cache
# Hyperliquid perp dexes (HIP-3). Hyperliquid hosts validator-operated books beside its own, and
# every /info read DEFAULTS to the first one — so pairs and positions are read once per dex, or a
# member holding positions only on a HIP-3 book is told they have none (spec 083,
# specs/083-perps-position-management/hyperliquid-decision.md §5.2). The venue's per-IP weight
# budget (1200/min, and this gateway is ONE IP for every member) is what these two bound.
#PERPS_HL_DEX_LIST_TTL_MS=3600000          # dex list cache; it is global, not per-member
#PERPS_HL_DEX_MAX=24                       # most dexes one read fans out to (10 existed 2026-08-12).
                                           # Dexes past the cap are NAMED in
                                           # sources.hyperliquid.unreadDexes — never silently dropped.
#PERPS_QUOTA_PER_IP=60                     # reads/min per caller IP
#PERPS_QUOTA_GLOBAL=300                    # reads/min backstop
#PERPS_QUOTA_WINDOW_MS=60000
#PERPS_KILLSWITCH=false
# Attribution (PUBLIC identifiers, never secrets). Unset => link-outs go unattributed
# rather than being blocked (never-stranded).
#PERPS_GAINS_REFERRER=                     # FairWins referrer address (gains referral program)
#PERPS_GMX_REF_CODE=                       # GMX referral code (1-20 chars [A-Za-z0-9_])
#PERPS_HL_BUILDER_ADDRESS=                 # FairWins builder wallet on Hyperliquid
# Hyperliquid builder fee FALLBACK bps — the FeeRouter service perps.hyperliquid.builder is the
# live source (spec 060). Hard-capped at Hyperliquid's 10 bps perps limit; boot fails above it.
#PERPS_HL_BUILDER_FEE_BPS=0

# ---- Member API (spec 095) --------------------------------------------------------------------
# Member-signed capability tokens granting custody-free, SCOPED access to a member's OWN data, plus
# unsigned typed-data quotes and a conversational assistant. Nothing here moves value: the strongest
# response is a payload the MEMBER signs, and relaying a signed intent stays on POST /v1/intents.
# Disabled (default) => every /v1/member/* route — including the OpenAPI document — answers 503
# member_api_unconfigured, so a client can tell "the operator turned it off" from "gateway too old".
#
# THE GATEWAY STORES NO KEYS. A key is an EIP-712 grant the member signs in the app; this process
# verifies the signature per request and keeps no copy. So MEMBER_API_MAX_TTL_DAYS is the real bound
# on a leaked key — revocations are in-process (Phase 1), do NOT survive a restart, and every
# revocation response says `durable: false` rather than implying otherwise.
#MEMBER_API_ENABLED=false
#MEMBER_API_KILLSWITCH=false               # ops kill: all /v1/member/* routes 503 member_api_killed
#MEMBER_API_MAX_TTL_DAYS=90                # a grant asking for more => 401 token_ttl_exceeded
# Chain membership + ERC-1271 signature checks are read on. Membership has ONE home per cohort;
# reading the caller's chain would let a testnet answer stand in for a mainnet fact. Defaults to the
# first enabled chain with a recorded membershipManager. Boot fails if this names a chain that has none.
#MEMBER_API_REFERENCE_CHAIN_ID=137
#MEMBER_API_MEMBERSHIP_CACHE_MS=60000      # per-account, SUCCESSES ONLY (a cached failure spreads one bad moment)
#MEMBER_API_CLOCK_SKEW_SEC=300             # tolerance for a client clock ahead of ours
#MEMBER_API_REVOCATION_MAX=50000           # in-memory revocation records
# Wager indexer per chain. UNSET => that chain answers state `not-configured`, which is NOT an empty
# wager list — the question was never asked. A failed fetch answers `unreadable`. Never `[]`.
#MEMBER_API_SUBGRAPH_137=https://api.studio.thegraph.com/query/<id>/fairwins-polygon/version/latest
#MEMBER_API_SUBGRAPH_80002=
#MEMBER_API_SUBGRAPH_63=
#MEMBER_API_TIMEOUT_MS=5000
# Quotas key on the RECOVERED ACCOUNT, not caller IP (trust proxy is unset and nginx fronts this
# container, so an IP key would pool every member into one bucket).
#MEMBER_API_QUOTA_PER_ACCOUNT=120
#MEMBER_API_QUOTA_GLOBAL=600
#MEMBER_API_QUOTA_WINDOW_MS=60000

# Assistant (POST /v1/member/assistant/chat). OFF by default, and off means that ONE route answers
# 503 assistant_unconfigured — losing the assistant never affects anything else. ANTHROPIC_API_KEY is
# a SECRET delivered by fetch-secrets.sh as an OPTIONAL credential: a missing key fails that route
# closed rather than failing the boot. Message content is NEVER logged; the audit event carries counts.
#ASSISTANT_ENABLED=false
#ANTHROPIC_API_KEY=                        # SECRET — never commit, never log, never echo in a response
#ASSISTANT_BASE_URL=https://api.anthropic.com
#ASSISTANT_MODEL=claude-sonnet-5
#ASSISTANT_MAX_TOKENS=1024
#ASSISTANT_TIMEOUT_MS=30000

# ---- x402 agentic payments (spec 096) ----------------------------------------------------------
# A pay-per-request rail on the member API's PRICED operations, for an agent that holds no member
# key. A priced call with no usable token answers 402 with machine-readable PaymentRequirements; the
# agent signs an EIP-3009 TransferWithAuthorization on this chain's USDC to X402_PAY_TO and retries
# with an X-PAYMENT header; the gateway verifies it, settles through the SAME engine the intent rail
# uses, and then serves the request as the PAYER. Disabled (default) => no route ever answers 402 and
# an unauthenticated priced request gets exactly the 401 it got before this module existed.
#
# MEMBERS ARE NEVER CHARGED. The bearer path is checked FIRST; a token that authenticates is served
# on it and the paid rail is not consulted at all. Paying substitutes for MEMBERSHIP on one
# operation — it is not an alternative way to use a key you already have.
#
# VERIFY THEN SETTLE THEN SERVE. Every check runs before anything is submitted, so a refused payment
# costs the payer nothing; an engine that cannot take the settlement answers 503
# settlement_unavailable and serves nothing (never a free serve, never a charge without an answer).
# The payer is sanctions-screened fail-closed, and EOA (ECDSA) signatures only — a smart-account
# signature would pass a server check and revert at the token, so it is refused up front.
#X402_ENABLED=false
#X402_KILLSWITCH=false                      # ops kill: the rail stops being OFFERED; members unaffected
# Chain payments are signed on and settled on. MUST be an enabled chain with an EIP-3009 payment
# token recorded (137/80002 — the ETC chains' token is permit-only); boot fails otherwise, because a
# rail that can never settle must not advertise a price. Defaults to the first such enabled chain.
#X402_CHAIN_ID=137
# The platform treasury every payment is made to. REQUIRED when enabled and deliberately has NO
# DEFAULT: a defaulted treasury address would send agents' money somewhere nobody chose.
#X402_PAY_TO=
#X402_SETTLE_BUFFER_SECONDS=60              # validity an authorization must have LEFT to be accepted
#X402_MAX_TIMEOUT_SECONDS=300               # maxTimeoutSeconds published in the offer
# Prices in USDC BASE UNITS (6 decimals: 10000 = $0.01). EACH AT 0 MEANS "NOT OFFERED", never "free":
# that op class is absent from the paid rail and its routes 401 exactly as they do today. All three
# at 0 fails boot — the module would be on and do nothing.
#X402_PRICE_READ=10000                      # GET /v1/member/wagers, GET /v1/member/fees
#X402_PRICE_BUILD=50000                     # POST /v1/member/intents/build
#X402_PRICE_ASSISTANT=100000                # POST /v1/member/assistant/chat (per message)
# Bound on the in-process replay set. PHASE 1 and honest about it: the TOKEN's own on-chain
# authorization state is the real uniqueness guarantee (a replay reverts), so this only saves the gas
# of finding out — a gateway restart cannot turn a replay into a double spend.
#X402_NONCE_MAX=50000

# --- Caller identity (spec 106) ---------------------------------------------------------------
# Two switches, deliberately: ENABLED resolves and reports (X-FairWins-Tier; NO status changes),
# ENFORCE refuses routes whose declared minimum is unmet. Deploy sequence is enable → watch the
# tier header on real traffic → enforce. All of these reload via SIGHUP (RELOAD_ENV_FILE below).
#IDENTITY_ENABLED=false
#IDENTITY_ENFORCE=false
#IDENTITY_KILLSWITCH=false                  # back to inert without touching the global KILL_SWITCH
# Turnstile siteverify secret (pairs with the SPA's public VITE_CHALLENGE_SITEKEY). Unset => the
# challenge verifier ABSTAINS — an unconfigured bot-check must never deny anyone. The published
# TEST secrets (1x/2x/3x…AA) are BOOT-FATAL in production: the always-pass one turns the human
# tier into a stamp anyone can print, invisibly.
#CHALLENGE_SECRET=
#CHALLENGE_TTL_SEC=900                      # how long ONE verified challenge serves a visitor
# Per-upstream call ceilings, charged BEFORE the outbound request (a cap on the response is a
# receipt, not a budget). Unset = unlimited — an ABSENT cap, stated, never a hidden default.
#UPSTREAM_CEILING_OPENSEA=
#UPSTREAM_CEILING_POLYMARKET=
# SIGHUP re-reads the allowlisted operational switches from this file (kill switches, enable
# flags, ceilings — NEVER keys/endpoints/addresses). Unset => SIGHUP answers honestly that
# nothing can reload. The process env is frozen at exec; this file is the reload source.
#RELOAD_ENV_FILE=

# --- Issued RPC access (spec 107) -------------------------------------------------------------
# POST /v1/access/rpc mints short-lived READ-ONLY JWTs for a dedicated provider endpoint; the SPA
# then reads DIRECTLY from the provider. Dormant (503 access_unconfigured) until endpoint pair +
# signing key + admin key are all present. Switch-on order matters — see the runbook on #1438.
#RPC_ACCESS_ENABLED=false
#RPC_ACCESS_KILLSWITCH=false
# KEY MATERIAL (spec 097 rule 3): PEM private key, RS256 (rsa) or ES256 (P-256). Arrives from
# Secret Manager via fetch-secrets.sh — never committed, never logged. Rotation is by SUCCESSION
# (new kid registered at the provider first); see docs/runbooks/credential-rotation.md.
#RPC_ACCESS_SIGNING_KEY=
#RPC_ACCESS_SIGNING_KID=
# Provider admin API key — the FR-026 enforcement check reads per-endpoint security state with it.
# NOTE: that response carries the endpoint's LIVE URL tokens in plaintext; treat this key's
# exposure as exposure of those.
#RPC_ACCESS_ADMIN_KEY=
# The issuance endpoint, as a PAIR — URL without the admin-API id is refused (without the id the
# enforcement check cannot run, and serving the endpoint would transmit an unverified credential).
#RPC_ACCESS_ENDPOINT_URL_137=
#RPC_ACCESS_ENDPOINT_ID_137=
# Tier shapes LIFETIME, never whether (anonymous callers mint too — keyed reads are not a member
# benefit). The provider enforces NO maximum lifetime, so MAX_TTL is the only backstop.
#RPC_ACCESS_TTL_ANONYMOUS_SEC=300
#RPC_ACCESS_TTL_MEMBER_SEC=1800
#RPC_ACCESS_MAX_TTL_SEC=3600
